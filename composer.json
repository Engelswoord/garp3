{
  "name": "engelswoord/garp3",
  "description": "Framework and CMS built on top of Zend Framework. Forked from grrr-amsterdam/garp3",
  "license": "BSD-3-Clause",
  "type": "library",
  "minimum-stability": "dev",
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "google/apiclient": "^1.1",
    "ezyang/htmlpurifier": "^4.12",
    "dompdf/dompdf": "^0.8.0",
    "tedivm/jshrink": "1.1.0",
    "vlucas/phpdotenv": "^v5.4",
    "fzaninotto/faker": "dev-master",
    "grrr-amsterdam/garp-functional": "^6.0",
    "greenlion/php-sql-parser": "^4.1",
    "league/csv": "^8.0",
    "aws/aws-sdk-php": "^3.87",
    "sentry/sdk": "^4.0",
    "shardj/zf1-future": "^1.24",
    "guzzlehttp/guzzle": "^6|^7"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.5",
    "phpunit/phpunit": "^9",
    "rector/rector": "dev-main"
  },
  "autoload": {
    "psr-0": {
      "Garp_": "library/",
      "G_": "application/modules/g/controllers",
      "G_View_Helpers_": "application/modules/g/views/helpers"
    },
    "files": [
      "application/functions.php"
    ],
    "classmap": [
      "application/modules/g/controllers",
      "application/modules/g/views/helpers",
      "packages/phpoffice-phpexcel/Classes"
    ]
  },
  "autoload-dev": {
    "psr-0": {
      "Mock_": "tests/mocks"
    }
  },
  "include-path": [
    "library/"
  ],
  "scripts": {
    "test": "phpunit --verbose --colors --bootstrap tests/TestHelper.php tests/",
    "phpcs": "vendor/bin/phpcs --standard=./phpcs.xml --extensions=php --colors ."
  },
  "suggest": {
    "phpunit/phpunit": "Required to use assertions and run tests (^6|^7)."
  },
  "bin": [
    "scripts/g"
  ],
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
